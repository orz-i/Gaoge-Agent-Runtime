      "operationId": "listHarnessCommands"
    },
    {
      "method": "get",
      "path": "/harness/turns/{turnID}",
      "operationId": "getHarnessTurn"
    },
    {
      "method": "get",
      "path": "/harness/turns/{turnID}/feed",
      "operationId": "streamHarnessTurnFeed"
    },
    {
      "method": "get",
      "path": "/harness/turns/{turnID}/state",
      "operationId": "getHarnessTurnState"
    },
    {
      "method": "get",
      "path": "/harness/turns/{turnID}/items",
      "operationId": "listHarnessTurnItems"
    },
    {
      "method": "post",
      "path": "/harness/turns/{turnID}/approval",
      "operationId": "resolveHarnessApproval"
    },
    {
      "method": "post",
      "path": "/harness/turns/{turnID}/allowance",
