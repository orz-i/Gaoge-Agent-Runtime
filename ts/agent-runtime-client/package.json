{
  "name": "@orz-i/agent-runtime-client",
  "version": "0.1.0-beta.14",
  "description": "Framework-neutral TypeScript client for the Gaoge Agent Runtime HTTP v1 API.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orz-i/Gaoge-Agent-Runtime.git",
    "directory": "ts/agent-runtime-client"
  },
  "homepage": "https://github.com/orz-i/Gaoge-Agent-Runtime#readme",
  "bugs": {
    "url": "https://github.com/orz-i/Gaoge-Agent-Runtime/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint src --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.8",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
